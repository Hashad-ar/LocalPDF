<Window x:Class="LocalPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalPDF" Width="840" Height="650" MinWidth="720" MinHeight="570"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing"
        DragEnter="Window_DragEnter" Drop="Window_Drop">
  <Grid Margin="30,24,30,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="LocalPDF" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Text="Private, local Word and PDF tools" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="#19251F" BorderBrush="#315B43" BorderThickness="1" CornerRadius="15" Padding="11,5" VerticalAlignment="Center">
        <TextBlock Text="●  Local-only" Foreground="#74D69A" FontSize="12" FontWeight="SemiBold" />
      </Border>
    </Grid>

    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
      <Button x:Name="WordToPdfButton" Style="{StaticResource ToolButton}" Content="Word → PDF" Click="Tool_Click" Tag="word-to-pdf" Margin="0,0,6,0" />
      <Button x:Name="PdfToWordButton" Style="{StaticResource ToolButton}" Content="PDF → Word" Click="Tool_Click" Tag="pdf-to-word" Margin="3,0,3,0" />
      <Button x:Name="MergeButton" Style="{StaticResource ToolButton}" Content="Merge PDFs" Click="Tool_Click" Tag="merge" Margin="6,0,0,0" />
    </UniformGrid>

    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
          <TextBlock x:Name="ToolTitle" Text="Word to PDF" FontSize="19" FontWeight="SemiBold" />
          <TextBlock x:Name="ToolDescription" Text="Create a faithful PDF using Microsoft Word on this computer." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,19,0,15">
          <Border x:Name="DropZone" Background="#15171B" BorderBrush="#4A4F5C" BorderThickness="1" CornerRadius="10" Padding="18"
                  MouseLeftButtonUp="Browse_Click" Cursor="Hand">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Background="#272334" CornerRadius="22" Width="44" Height="44" Margin="0,0,0,12">
                <TextBlock Text="＋" Foreground="{StaticResource AccentHoverBrush}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock x:Name="DropTitle" Text="Drop a Word file here" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
              <TextBlock Text="or click to browse" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <Grid x:Name="SelectionPanel" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ListBox x:Name="FileList" Grid.Row="0" AllowDrop="True" SelectionMode="Single"
                     PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown" PreviewMouseMove="FileList_PreviewMouseMove" Drop="FileList_Drop">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="▤" Foreground="{StaticResource AccentHoverBrush}" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="Grip" Text="⋮⋮" Foreground="{StaticResource MutedBrush}" FontSize="17" VerticalAlignment="Center" />
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsMerge, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                      <Setter TargetName="Grip" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="1" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="AddButton" Content="Add PDFs" Click="Browse_Click" Padding="12,7" Visibility="Collapsed" />
                <Button x:Name="UpButton" Content="↑" Click="MoveUp_Click" Padding="11,7" Margin="7,0,0,0" Visibility="Collapsed" ToolTip="Move selected PDF up" />
                <Button x:Name="DownButton" Content="↓" Click="MoveDown_Click" Padding="11,7" Margin="7,0,0,0" Visibility="Collapsed" ToolTip="Move selected PDF down" />
                <Button Content="Remove" Click="Remove_Click" Padding="12,7" Margin="7,0,0,0" />
              </StackPanel>
              <Button Content="Clear" Click="Clear_Click" Padding="12,7" HorizontalAlignment="Right" />
            </Grid>
          </Grid>

          <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="ProgressTitle" Text="Working locally…" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="ProgressMessage" Text="Preparing…" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,17" HorizontalAlignment="Center" />
            <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0" />
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Margin="0,18,0,0" HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel x:Name="DonePanel" Visibility="Collapsed" VerticalAlignment="Center">
            <Border Background="#1E3528" CornerRadius="28" Width="56" Height="56" Margin="0,0,0,13">
              <TextBlock Text="✓" Foreground="#74D69A" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Finished" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="DoneFileName" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,14" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Content="Open file" Click="OpenFile_Click" />
              <Button Content="Open folder" Click="OpenFolder_Click" Margin="8,0,0,0" />
              <Button Content="Start another" Click="Reset_Click" Margin="8,0,0,0" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
          <TextBlock x:Name="HintText" Text=".docx and .doc files • Microsoft Word required" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
          <Button x:Name="RunButton" Content="Convert to PDF" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Run_Click" IsEnabled="False" />
        </Grid>
      </Grid>
    </Border>

    <TextBlock Grid.Row="3" Text="LocalPDF never uploads files or connects to the internet. Word conversions use Microsoft Word." Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0" />
  </Grid>
</Window>
